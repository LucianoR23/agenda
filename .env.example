# Copy to .env and fill in. Placeholders only: never commit real values.
# Validated at boot (src/server/env.ts); a missing or malformed value stops the server with a clear message.

NODE_ENV=development
# Postgres. Local: `pnpm db:up` (Docker). In Coolify use the internal hostname of postgres-core, DB `agenda`.
DATABASE_URL=postgres://agenda:agenda@localhost:5433/agenda_dev
# Tests only; the test setup refuses any database whose name doesn't end in _test.
TEST_DATABASE_URL=postgres://agenda:agenda@localhost:5433/agenda_test

APP_ORIGIN=http://localhost:3000
TZ=America/Buenos_Aires

# openssl rand -base64 32
SESSION_SECRET=
# One-time code for the first-run setup screen (8+ characters)
SETUP_CODE=

WEBAUTHN_RP_ID=localhost

# npx web-push generate-vapid-keys (all three or none)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Phase 6: encrypts Google refresh tokens and iCal URLs (openssl rand -base64 32)
ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated browser origins allowed to call the token API
CORS_ALLOWED_ORIGINS=https://sunday.lemydev.com
# true only when traffic comes through Cloudflare (trust CF-Connecting-IP)
TRUST_CF=false

PIN_REAUTH_DAYS=7
DEVICE_TRUST_DAYS=90

APP_VERSION=dev
DISABLE_WORKER=false
SKIP_MIGRATIONS=false
# debug | info | warn | error
LOG_LEVEL=info
