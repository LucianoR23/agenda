# Copy to .env and fill in. Placeholders only — never commit real values.

# Postgres. In Coolify use the internal hostname of the Postgres resource.
DATABASE_URL=postgres://agenda:agenda@localhost:5433/agenda
TEST_DATABASE_URL=postgres://agenda:agenda@localhost:5434/agenda_test

APP_ORIGIN=https://agenda.lemydev.com
TZ=America/Buenos_Aires

# openssl rand -base64 32
SESSION_SECRET=change-me
# Required once, on the first-run setup screen
SETUP_CODE=change-me

# `pnpm agent:token` prints a token (give to Agenbot) and its SHA-256 hash (put here)
AGENT_TOKEN_HASH=change-me
# Sent by the Coolify scheduled task as X-Internal-Token
INTERNAL_TOKEN=change-me

WEBAUTHN_RP_ID=agenda.lemydev.com

# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:you@example.com

AGENT_WEBHOOK_URL=https://agenbot.example.com/webhooks/agenda
AGENT_WEBHOOK_TOKEN=change-me
WEBHOOK_DEBOUNCE_SECONDS=120

# Morning push when last night's sleep is incomplete (local HH:mm)
SLEEP_REMINDER_TIME=10:00

PIN_REAUTH_DAYS=7
DEVICE_TRUST_DAYS=90
