{
  "name": "agenda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "biome check .",
    "fix": "biome check --write .",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "openapi:gen": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "openapi:lint": "redocly lint openapi.yaml",
    "icons": "tsx scripts/icons.ts",
    "icons:check": "tsx scripts/icons.ts --check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "auth:reset-pin": "tsx scripts/auth-reset-pin.ts",
    "auth:recovery-codes": "tsx scripts/auth-recovery-codes.ts",
    "test:coverage": "vitest run --coverage",
    "pwa:icons": "node scripts/pwa-icons.mjs",
    "test:e2e": "playwright test",
    "build:cli": "node scripts/build-cli.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@node-rs/argon2": "^2.2.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tanstack/react-query": "^5.107.1",
    "dexie": "^4.4.7",
    "drizzle-orm": "^0.45.4",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "node-ical": "0.27.6",
    "postgres": "^4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rrule-temporal": "2.2.8",
    "temporal-polyfill": "1.0.8",
    "uuidv7": "^1.2.1",
    "web-push": "^4.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@material-symbols/svg-400": "^0.48.0",
    "@playwright/test": "^1.65.0",
    "@redocly/cli": "^2.77.0",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26"
  }
